# RazorPay Test Mode Credentials
# Get these from https://dashboard.razorpay.com/#/app/keys (Test Mode)
# If left blank or default, the app seamlessly runs in built-in MOCK MODE!
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# AI Model Keys (Optional)
# If provided, uses Gemini 1.5 Flash for natural language reasoning.
# If left blank or default, the app uses intelligent keyword & pattern matching!
GEMINI_API_KEY=your_gemini_key_here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
